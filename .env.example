# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# Server configuration
PORT=3000

# Optional MongoDB connection string. When provided, RepoMind uses MongoDB + Mongoose.
# When omitted, RepoMind persists data to a local atomic store in ./data/store.json.
MONGODB_URI=""

# JWT secret for signing authentication tokens (auto-generated ephemeral secret in dev if omitted)
JWT_SECRET=""

# GitHub OAuth credentials (optional; public repositories can be analyzed without OAuth)
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GITHUB_CALLBACK_URL=""
